# Público (somente valores realmente públicos)
NEXT_PUBLIC_SITE_URL=https://magiaastarte.com.br

# Mercado Pago (somente servidor)
MERCADO_PAGO_MODE=test
MERCADO_PAGO_ACCESS_TOKEN=

# Redis / Upstash (somente servidor)
# Obrigatório na Vercel (Production/Preview): sessão HttpOnly e pedidos não usam memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ORDER_STORE_MODE=memory

# Criptografia de pedidos sensíveis no Redis (32 bytes em hex 64 chars ou base64)
MDA_DATA_ENCRYPTION_KEY=

# Meta CAPI (somente servidor)
META_CAPI_ACCESS_TOKEN=

# Kiwify webhook (somente servidor) — grafia real do projeto
KIWIFY_WEBHOOK_TOKEN=
